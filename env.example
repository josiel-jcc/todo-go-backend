# Server Configuration
PORT=8080
# development | production (production enforces JWT_SECRET and CORS)
APP_ENV=development

# JWT Configuration (required: >= 32 chars in production)
JWT_SECRET=your-secret-key-change-in-production

# Cookie (session) — used with HttpOnly auth_token cookie
COOKIE_DOMAIN=
COOKIE_SECURE=false
# lax | none | strict — use "none" when frontend and API are on different domains (requires HTTPS)
COOKIE_SAMESITE=lax

# Database Configuration (SQLite - default)
DATABASE_PATH=todo.db

# MySQL Configuration (for Docker/Production)
# Uncomment and configure these if using MySQL
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=todo_user
DATABASE_PASSWORD=todo_password
DATABASE_NAME=todo_db

# MySQL Root Password (for Docker)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=todo_db
MYSQL_USER=todo_user
MYSQL_PASSWORD=todo_password
MYSQL_PORT=3306

# CORS Configuration
# Comma-separated list of allowed origins (wildcard NOT allowed when APP_ENV=production)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated list of allowed HTTP methods
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
# Comma-separated list of allowed headers
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,Origin
# Comma-separated list of exposed headers (optional)
# CORS_EXPOSED_HEADERS=
# Whether to allow credentials (true/false, default: true)
CORS_ALLOW_CREDENTIALS=true
# Max age for preflight requests in seconds (default: 3600)
CORS_MAX_AGE=3600

# Notifications Configuration
# Enable/disable notifications (true/false, default: true)
NOTIFICATIONS_ENABLED=true
# Cron expression for notification check (every minute in production)
NOTIFICATION_CHECK_INTERVAL=* * * * *
# Run scheduler in this process (set false on extra API replicas when scaling horizontally)
RUN_SCHEDULER=true

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@todoapp.com

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Web Push VAPID Configuration
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push service (mailto: or https:// URL)
VAPID_SUBJECT=mailto:admin@example.com

# Cloudflare Tunnel Configuration
# Token for Cloudflare Tunnel (get from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

